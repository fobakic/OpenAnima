<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Header & Window -->
    <sys:String x:Key="App_Title">OpenAnima — Lightweight Desktop Overlay Engine</sys:String>
    <sys:String x:Key="Header_Tagline">• Free lightweight desktop overlay engine</sys:String>
    <sys:String x:Key="Header_HideAll">Hide all</sys:String>
    <sys:String x:Key="Header_ShowAll">Show all</sys:String>
    <sys:String x:Key="Header_ToggleTooltip">Quickly hide or show all characters on screen</sys:String>
    <sys:String x:Key="Active_Count_Zero">0 active</sys:String>
    <sys:String x:Key="Active_Count_Singular">1 active</sys:String>
    <sys:String x:Key="Active_Count_Plural">{0} active</sys:String>

    <!-- Navigation Tabs -->
    <sys:String x:Key="Tab_Library">Library</sys:String>
    <sys:String x:Key="Tab_Community">Community Hub</sys:String>
    <sys:String x:Key="Tab_Tools">Tools</sys:String>
    <sys:String x:Key="Tab_Settings">Settings</sys:String>

    <!-- Library Toolbar -->
    <sys:String x:Key="Btn_AddAnimation">Add animation</sys:String>
    <sys:String x:Key="Btn_StopAll">Stop all</sys:String>
    <sys:String x:Key="Btn_Samples">Samples (from models)</sys:String>
    <sys:String x:Key="Search_Placeholder">Search animations...</sys:String>

    <!-- Empty State -->
    <sys:String x:Key="Empty_Title">No characters in library yet</sys:String>
    <sys:String x:Key="Empty_Desc">Drag and drop GIF, PNG or APNG here from Explorer, or click below</sys:String>
    <sys:String x:Key="Empty_BtnAdd">Add animation</sys:String>
    <sys:String x:Key="Empty_BtnSamples">Load samples</sys:String>

    <!-- Animation Card -->
    <sys:String x:Key="Card_Status_Stopped">Stopped</sys:String>
    <sys:String x:Key="Card_Status_Active">Active on screen</sys:String>
    <sys:String x:Key="Card_Tooltip_Reveal">Show file in Explorer</sys:String>
    <sys:String x:Key="Card_Tooltip_Delete">Remove from library</sys:String>
    <sys:String x:Key="Card_Opacity">Opacity</sys:String>
    <sys:String x:Key="Card_Scale">Scale (of screen)</sys:String>
    <sys:String x:Key="Card_AlwaysOnTop">Always on top</sys:String>
    <sys:String x:Key="Card_ClickThrough">Click-through</sys:String>
    <sys:String x:Key="Card_Smoothing">Smoothing</sys:String>
    <sys:String x:Key="Card_Physics">Physics</sys:String>
    <sys:String x:Key="Card_Physics_Tooltip">Gravity, bounce off taskbar, mouse throw (disabled by default)</sys:String>
    <sys:String x:Key="Card_Bouncy">Bouncy</sys:String>
    <sys:String x:Key="Card_Bouncy_Tooltip">Springy elastic bounce on impact with taskbar/walls (toggleable)</sys:String>
    <sys:String x:Key="Card_ChromaKey">Chroma key (bg)</sys:String>
    <sys:String x:Key="Card_ChromaKey_Tooltip">Remove solid background on the fly</sys:String>
    <sys:String x:Key="Card_ChromaColor">Background color:</sys:String>
    <sys:String x:Key="Card_Eyedropper">Pick</sys:String>
    <sys:String x:Key="Card_Eyedropper_Tooltip">Pick color from top-left pixel or click anywhere on screen</sys:String>
    <sys:String x:Key="Card_ChromaTolerance">Tolerance:</sys:String>
    <sys:String x:Key="Card_ChromaContiguous">Outside only (protects white inside)</sys:String>
    <sys:String x:Key="Card_ChromaContiguous_Tooltip">Flood-fill algorithm starts from outer borders and leaves inner color untouched</sys:String>
    <sys:String x:Key="Card_LaunchOverlay">Launch overlay</sys:String>
    <sys:String x:Key="Card_CloseOverlay">Close overlay</sys:String>

    <!-- Community Hub Tab -->
    <sys:String x:Key="Community_Title">Open Animation Catalog (OpenAnima Hub)</sys:String>
    <sys:String x:Key="Community_Desc">Free open-source alternative to Steam Workshop. Community can publish animation packs via GitHub or CDN, and you can download them in one click.</sys:String>
    <sys:String x:Key="Community_CardTitle">GitHub Community Catalog</sys:String>
    <sys:String x:Key="Community_CardStatus">Status: Under development (planned for v0.2)</sys:String>
    <sys:String x:Key="Community_BtnGitHub">Open Project GitHub Repository</sys:String>

    <!-- Tools Tab -->
    <sys:String x:Key="Tools_Title">Creator Tools</sys:String>
    <sys:String x:Key="Tools_Desc">Media preparation before using as desktop overlays.</sys:String>
    <sys:String x:Key="Tools_Chroma_Title">Solid Background Removal (Real-time Chroma Key)</sys:String>
    <sys:String x:Key="Tools_Chroma_Desc">Built into each library card: remove white, green, or any background with inner text protection and eyedropper.</sys:String>
    <sys:String x:Key="Tools_BtnToLibrary">Go to library</sys:String>
    <sys:String x:Key="Tools_Mp4_Title">MP4 -> Overlay Converter</sys:String>
    <sys:String x:Key="Tools_Mp4_Desc">Convert any short video clip into optimized APNG / GIF.</sys:String>
    <sys:String x:Key="Tools_InDev">In development (v0.2)</sys:String>
    <sys:String x:Key="Tools_Ai_Title">AI Background Removal Plugin</sys:String>
    <sys:String x:Key="Tools_Ai_Desc">Modular plugin based on ONNX / Rembg (kept external to avoid bloating package).</sys:String>

    <!-- Settings Tab -->
    <sys:String x:Key="Settings_Title">OpenAnima Preferences</sys:String>
    <sys:String x:Key="Settings_Language_Title">Interface Language</sys:String>
    <sys:String x:Key="Settings_Language_Desc">Select your preferred display language (changes take effect immediately)</sys:String>
    <sys:String x:Key="Settings_Tray_Title">System Tray and Startup</sys:String>
    <sys:String x:Key="Settings_MinimizeToTray">Minimize to tray on [X] close (keep overlays visible on screen)</sys:String>
    <sys:String x:Key="Settings_StartMinimized">Start application minimized to tray</sys:String>
    <sys:String x:Key="Settings_AutoStart">Start automatically with Windows</sys:String>
    <sys:String x:Key="Settings_RestoreOverlays">Restore active overlays on startup</sys:String>
    <sys:String x:Key="Settings_AggressiveMemory">Aggressive RAM trimming (drop to ~15 MB on minimize)</sys:String>
    <sys:String x:Key="Settings_Profile_Title">Profile and Storage</sys:String>
    <sys:String x:Key="Settings_Profile_Desc">Positions (X, Y), transparency and settings are synced to %APPDATA%\OpenAnima\config.json.</sys:String>
    <sys:String x:Key="Settings_BtnSaveProfile">Save Profile</sys:String>
    <sys:String x:Key="Settings_Core_Title">Core Status (Rust Microcore)</sys:String>
    <sys:String x:Key="Settings_BtnRestartCore">Restart Core</sys:String>
    <sys:String x:Key="Settings_BtnTrimMemory">Trim Memory (Trim RAM)</sys:String>
    <sys:String x:Key="Settings_About_Title">About OpenAnima</sys:String>
    <sys:String x:Key="Settings_About_Desc">OpenAnima is a free, high-performance, open-source alternative to commercial overlay engines. Built with C# (.NET 8) and Rust.</sys:String>
    <sys:String x:Key="Settings_About_License">License: MIT (Open Source)</sys:String>

    <!-- Status Bar & Runtime Messages -->
    <sys:String x:Key="Status_Initializing">Initializing OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_Connecting">Connecting to OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_CoreError">Error: unable to start OpenAnima.Core</sys:String>
    <sys:String x:Key="Status_CoreUnavailable">Core is not running or unavailable. Click 'Restart Core'.</sys:String>
    <sys:String x:Key="Status_AllHidden">All overlays temporarily hidden from screen</sys:String>
    <sys:String x:Key="Status_AllShown">Overlays are displayed on screen</sys:String>
    <sys:String x:Key="Status_Saved">Saved at {0}</sys:String>
    <sys:String x:Key="Status_CoreRunning_Format">Core: {0:F1} MB (PID: {1}) • Interface: {2:F1} MB • Channel: openanima-core-v1</sys:String>
    <sys:String x:Key="Status_CoreActive_Format">Core active (Rust PID: {0}, RAM: {1:F1} MB, GUI interface: {2:F1} MB)</sys:String>
    <sys:String x:Key="Status_RestartingCore">Restarting OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_FilesAdded">Added files: {0}</sys:String>
    <sys:String x:Key="Status_AnimationRemoved">Animation '{0}' removed from library</sys:String>
    <sys:String x:Key="Dialog_SelectAnimation_Title">Select animation (GIF, PNG, APNG)</sys:String>
    <sys:String x:Key="Dialog_SelectAnimation_Filter">Animations (*.gif;*.png;*.apng)|*.gif;*.png;*.apng|All files (*.*)|*.*</sys:String>
    <sys:String x:Key="Status_EyedropperCorner">Background color detected from top-left (0,0): {0}</sys:String>

    <!-- Tray Context Menu -->
    <sys:String x:Key="Tray_Open">Open OpenAnima</sys:String>
    <sys:String x:Key="Tray_HideAll">Hide all characters</sys:String>
    <sys:String x:Key="Tray_ShowAll">Show all characters</sys:String>
    <sys:String x:Key="Tray_StopAll">Stop all</sys:String>
    <sys:String x:Key="Tray_Exit">Exit</sys:String>

</ResourceDictionary>
