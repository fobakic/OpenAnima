<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Header & Window -->
    <sys:String x:Key="App_Title">OpenAnima — Легковесный движок оверлеев</sys:String>
    <sys:String x:Key="Header_Tagline">• Свободный легковесный движок оверлеев</sys:String>
    <sys:String x:Key="Header_HideAll">Скрыть всех</sys:String>
    <sys:String x:Key="Header_ShowAll">Показать всех</sys:String>
    <sys:String x:Key="Header_ToggleTooltip">Быстро скрыть или показать всех персонажей на экране</sys:String>
    <sys:String x:Key="Active_Count_Zero">0 активных</sys:String>
    <sys:String x:Key="Active_Count_Singular">1 активен</sys:String>
    <sys:String x:Key="Active_Count_Plural">{0} активных</sys:String>

    <!-- Navigation Tabs -->
    <sys:String x:Key="Tab_Library">Библиотека</sys:String>
    <sys:String x:Key="Tab_Community">Каталог сообщества</sys:String>
    <sys:String x:Key="Tab_Tools">Инструменты</sys:String>
    <sys:String x:Key="Tab_Settings">Настройки</sys:String>

    <!-- Library Toolbar -->
    <sys:String x:Key="Btn_AddAnimation">Добавить анимацию</sys:String>
    <sys:String x:Key="Btn_StopAll">Остановить все</sys:String>
    <sys:String x:Key="Btn_Samples">Примеры (из models)</sys:String>
    <sys:String x:Key="Search_Placeholder">Поиск анимаций...</sys:String>

    <!-- Empty State -->
    <sys:String x:Key="Empty_Title">В библиотеке пока нет персонажей</sys:String>
    <sys:String x:Key="Empty_Desc">Перетащите сюда GIF или PNG из проводника, либо нажмите кнопку ниже</sys:String>
    <sys:String x:Key="Empty_BtnAdd">Добавить анимацию</sys:String>
    <sys:String x:Key="Empty_BtnSamples">Загрузить примеры</sys:String>

    <!-- Animation Card -->
    <sys:String x:Key="Card_Status_Stopped">Остановлена</sys:String>
    <sys:String x:Key="Card_Status_Active">Активна на экране</sys:String>
    <sys:String x:Key="Card_Tooltip_Reveal">Показать файл в проводнике</sys:String>
    <sys:String x:Key="Card_Tooltip_Delete">Удалить из библиотеки</sys:String>
    <sys:String x:Key="Card_Opacity">Прозрачность</sys:String>
    <sys:String x:Key="Card_Scale">Масштаб (от экрана)</sys:String>
    <sys:String x:Key="Card_AlwaysOnTop">Поверх окон</sys:String>
    <sys:String x:Key="Card_ClickThrough">Клик насквозь</sys:String>
    <sys:String x:Key="Card_Smoothing">Сглаживание</sys:String>
    <sys:String x:Key="Card_Physics">Физика</sys:String>
    <sys:String x:Key="Card_Physics_Tooltip">Гравитация, падение на панель задач, бросок мышкой (по умолчанию выкл)</sys:String>
    <sys:String x:Key="Card_Bouncy">Пружинить</sys:String>
    <sys:String x:Key="Card_Bouncy_Tooltip">Мягкий пружинящий отскок при падении и ударах (можно выключить)</sys:String>
    <sys:String x:Key="Card_ChromaKey">Хромакей (фон)</sys:String>
    <sys:String x:Key="Card_ChromaKey_Tooltip">Удаление однотонного фона на лету</sys:String>
    <sys:String x:Key="Card_ChromaColor">Цвет фона:</sys:String>
    <sys:String x:Key="Card_Eyedropper">Пипетка</sys:String>
    <sys:String x:Key="Card_Eyedropper_Tooltip">Взять цвет с левого верхнего угла или кликом по экрану</sys:String>
    <sys:String x:Key="Card_ChromaTolerance">Порог:</sys:String>
    <sys:String x:Key="Card_ChromaContiguous">Только снаружи (защищает белый внутри)</sys:String>
    <sys:String x:Key="Card_ChromaContiguous_Tooltip">Алгоритм заливки стартует от внешних границ и не трогает белый цвет внутри букв и персонажа</sys:String>
    <sys:String x:Key="Card_LaunchOverlay">Запустить оверлей</sys:String>
    <sys:String x:Key="Card_CloseOverlay">Закрыть оверлей</sys:String>

    <!-- Community Hub Tab -->
    <sys:String x:Key="Community_Title">Открытый каталог анимаций (OpenAnima Hub)</sys:String>
    <sys:String x:Key="Community_Desc">Бесплатная альтернатива мастерской Steam. Сообщество может публиковать наборы анимаций через репозиторий GitHub или CDN, а вы можете скачивать их в один клик.</sys:String>
    <sys:String x:Key="Community_CardTitle">GitHub Community Catalog</sys:String>
    <sys:String x:Key="Community_CardStatus">Статус: В разработке (планируется в версии 0.2)</sys:String>
    <sys:String x:Key="Community_BtnGitHub">Открыть репозиторий проекта на GitHub</sys:String>

    <!-- Tools Tab -->
    <sys:String x:Key="Tools_Title">Инструменты для авторов</sys:String>
    <sys:String x:Key="Tools_Desc">Подготовка медиафайлов перед использованием в качестве оверлеев.</sys:String>
    <sys:String x:Key="Tools_Chroma_Title">Удаление однотонного фона (Хромакей на лету)</sys:String>
    <sys:String x:Key="Tools_Chroma_Desc">Встроено в каждую карточку библиотеки: удаление белого, зеленого или любого фона с защитой надписей и пипеткой.</sys:String>
    <sys:String x:Key="Tools_BtnToLibrary">В библиотеку</sys:String>
    <sys:String x:Key="Tools_Mp4_Title">Конвертер MP4 -> Оверлей</sys:String>
    <sys:String x:Key="Tools_Mp4_Desc">Конвертация любого короткого видеоклипа в оптимизированный APNG / GIF.</sys:String>
    <sys:String x:Key="Tools_InDev">В разработке (v0.2)</sys:String>
    <sys:String x:Key="Tools_Ai_Title">Плагин: Удаление фона с ИИ (AI Background Removal)</sys:String>
    <sys:String x:Key="Tools_Ai_Desc">Модульный плагин на базе ONNX / Rembg (вынесен отдельно, чтобы не раздувать билд).</sys:String>

    <!-- Settings Tab -->
    <sys:String x:Key="Settings_Title">Параметры OpenAnima</sys:String>
    <sys:String x:Key="Settings_Language_Title">Язык интерфейса</sys:String>
    <sys:String x:Key="Settings_Language_Desc">Выберите язык интерфейса (изменения применяются мгновенно)</sys:String>
    <sys:String x:Key="Settings_Tray_Title">Системный трей и запуск</sys:String>
    <sys:String x:Key="Settings_MinimizeToTray">Сворачивать в трей при нажатии [X] (оставлять персонажей на экране)</sys:String>
    <sys:String x:Key="Settings_StartMinimized">Запускать приложение свёрнутым в трей</sys:String>
    <sys:String x:Key="Settings_AutoStart">Автозапуск вместе с Windows</sys:String>
    <sys:String x:Key="Settings_RestoreOverlays">Восстанавливать активные оверлеи при запуске</sys:String>
    <sys:String x:Key="Settings_AggressiveMemory">Агрессивная оптимизация RAM (сбрасывать до ~15 МБ при сворачивании)</sys:String>
    <sys:String x:Key="Settings_Profile_Title">Профиль и сохранение</sys:String>
    <sys:String x:Key="Settings_Profile_Desc">Позиции перетаскивания (X, Y), прозрачность и настройки синхронизируются в %APPDATA%\OpenAnima\config.json.</sys:String>
    <sys:String x:Key="Settings_BtnSaveProfile">Сохранить профиль</sys:String>
    <sys:String x:Key="Settings_Core_Title">Статус ядра (Rust Microcore)</sys:String>
    <sys:String x:Key="Settings_BtnRestartCore">Перезапустить ядро</sys:String>
    <sys:String x:Key="Settings_BtnTrimMemory">Очистить память (Trim RAM)</sys:String>
    <sys:String x:Key="Settings_About_Title">О проекте</sys:String>
    <sys:String x:Key="Settings_About_Desc">OpenAnima — свободная и оптимизированная альтернатива коммерческим оверлеям. Написано на C# (.NET 8) и Rust.</sys:String>
    <sys:String x:Key="Settings_About_License">Лицензия: MIT (Open Source)</sys:String>

    <!-- Status Bar & Runtime Messages -->
    <sys:String x:Key="Status_Initializing">Инициализация ядра OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_Connecting">Подключение к ядру OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_CoreError">Ошибка: не удалось запустить ядро OpenAnima.Core</sys:String>
    <sys:String x:Key="Status_CoreUnavailable">Ядро не запущено или недоступно. Нажмите 'Перезапустить ядро'.</sys:String>
    <sys:String x:Key="Status_AllHidden">Все оверлеи временно скрыты с экрана</sys:String>
    <sys:String x:Key="Status_AllShown">Оверлеи отображаются на экране</sys:String>
    <sys:String x:Key="Status_Saved">Сохранено в {0}</sys:String>
    <sys:String x:Key="Status_CoreRunning_Format">Ядро: {0:F1} МБ (PID: {1}) • Интерфейс: {2:F1} МБ • Канал: openanima-core-v1</sys:String>
    <sys:String x:Key="Status_CoreActive_Format">Ядро активно (Rust PID: {0}, RAM: {1:F1} МБ, интерфейс GUI: {2:F1} МБ)</sys:String>
    <sys:String x:Key="Status_RestartingCore">Перезапуск ядра OpenAnima.Core...</sys:String>
    <sys:String x:Key="Status_FilesAdded">Добавлено файлов: {0}</sys:String>
    <sys:String x:Key="Status_AnimationRemoved">Анимация '{0}' удалена из библиотеки</sys:String>
    <sys:String x:Key="Dialog_SelectAnimation_Title">Выберите анимацию (GIF, PNG, APNG)</sys:String>
    <sys:String x:Key="Dialog_SelectAnimation_Filter">Анимации (*.gif;*.png;*.apng)|*.gif;*.png;*.apng|Все файлы (*.*)|*.*</sys:String>
    <sys:String x:Key="Status_EyedropperCorner">Цвет фона определен из угла (0,0): {0}</sys:String>

    <!-- Tray Context Menu -->
    <sys:String x:Key="Tray_Open">Открыть OpenAnima</sys:String>
    <sys:String x:Key="Tray_HideAll">Скрыть всех персонажей</sys:String>
    <sys:String x:Key="Tray_ShowAll">Показать всех персонажей</sys:String>
    <sys:String x:Key="Tray_StopAll">Остановить всех</sys:String>
    <sys:String x:Key="Tray_Exit">Выход</sys:String>

</ResourceDictionary>
